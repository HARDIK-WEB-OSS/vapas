APP_ENV=production
PUBLIC_APP_URL=https://PROJECT.vercel.app
DATABASE_URL=postgresql+asyncpg://vapas_app:SET-IN-FLY-SECRETS@db.example.supabase.co:5432/postgres
WORKER_DATABASE_URL=postgresql+asyncpg://vapas_worker:SET-IN-FLY-SECRETS@db.example.supabase.co:5432/postgres
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:SET-IN-FLY-SECRETS@db.example.supabase.co:5432/postgres
REDIS_URL=rediss://default:SET-IN-FLY-SECRETS@example.upstash.io:6379/0
S3_ENDPOINT_URL=https://ACCOUNT-ID.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET_RAW=vapas-raw
S3_ACCESS_KEY_ID=SET-IN-FLY-SECRETS
S3_SECRET_ACCESS_KEY=SET-IN-FLY-SECRETS
JWT_SECRET=SET-IN-FLY-SECRETS
KEK_KEYS={"1":"SET-IN-FLY-SECRETS"}
KEK_ACTIVE_VERSION=1
MAIL_BACKEND=smtp
SMTP_USERNAME=YOUR-GMAIL@gmail.com
SMTP_PASSWORD=SET-IN-FLY-SECRETS
EMAIL_FROM=VAPAS <YOUR-GMAIL@gmail.com>
SENTRY_DSN=SET-IN-FLY-SECRETS
CLIENT_IP_HEADER=X-Vapas-Client-IP
PROXY_SHARED_SECRET=SET-IN-FLY-SECRETS
REFRESH_COOKIE_PATH=/api/auth
INVITE_ONLY=true
OLLAMA_URL=
LLM_FALLBACK_ENABLED=false
LETTER_POLISH_ENABLED=false
KILL_SWITCH=false
